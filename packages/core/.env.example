# Otonom Fabrika - Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayarak .env oluşturun: cp .env.example .env
# .env dosyasını asla git'e push ETMEYİN!

# PostgreSQL Bağlantısı (WSL içindeki PostgreSQL)
DATABASE_URL="postgres://KULLANICI_ADI:SIFRE@localhost:5432/otonom_fabrika"

# RTX Sunucu Portları
VLLM_BASE_URL="http://localhost:8000/v1"       # Qwen 32B Coder ve DeepSeek R1 32B
EXL2_BASE_URL="http://localhost:5000/v1"        # Llama 3.3 70B (TabbyAPI/ExLlamaV2)
EMBEDDING_BASE_URL="http://localhost:8001/v1"   # Nomic-Embed-Text (RAG için)

# Dashboard API Port
DASHBOARD_PORT="3001"

# Cloud Fallback (Devre Kesici aktifleşince devreye girer)
# https://openrouter.ai/keys adresinden ücretsiz alabilirsiniz
OPENROUTER_API_KEY=""
